FROM nousresearch/hermes-agent:latest

USER root

# 1. Install OpenJDK 21, zip, unzip, curl, and git (ca-certificates included)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jdk-headless \
    curl \
    unzip \
    zip \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 2. Install modern Gradle (v8.12.1)
ARG GRADLE_VERSION=8.12.1
RUN curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o /tmp/gradle.zip \
    && unzip -q /tmp/gradle.zip -d /opt \
    && ln -s /opt/gradle-${GRADLE_VERSION}/bin/gradle /usr/local/bin/gradle \
    && chmod -R go+rx /opt/gradle-${GRADLE_VERSION} \
    && rm -f /tmp/gradle.zip

# 3. Install modern Kotlin compiler CLI (v2.1.10)
ARG KOTLIN_VERSION=2.1.10
RUN curl -fsSL "https://github.com/JetBrains/kotlin/releases/download/v${KOTLIN_VERSION}/kotlin-compiler-${KOTLIN_VERSION}.zip" -o /tmp/kotlinc.zip \
    && unzip -q /tmp/kotlinc.zip -d /opt \
    && ln -s /opt/kotlinc/bin/kotlinc /usr/local/bin/kotlinc \
    && ln -s /opt/kotlinc/bin/kotlin /usr/local/bin/kotlin \
    && chmod -R go+rx /opt/kotlinc \
    && rm -f /tmp/kotlinc.zip

# 4. Set Java environment variables and safe default Gradle memory limits
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 \
    GRADLE_OPTS="-Dorg.gradle.daemon=false -Dorg.gradle.jvmargs=\"-Xmx1024m -XX:MaxMetaspaceSize=256m\""

# 5. Pre-configure system-wide SSH client defaults for cluster nodes
RUN mkdir -p /etc/ssh/ssh_config.d && \
    printf 'Host 192.168.4.18 shawn-candy chromebook\n    HostName 192.168.4.18\n    User shawn\n    IdentityFile /opt/data/.ssh/id_ed25519_hermes\n    IdentitiesOnly yes\n    StrictHostKeyChecking accept-new\n    UserKnownHostsFile /opt/data/.ssh/known_hosts\n\nHost 192.168.4.5 rpi5\n    HostName 192.168.4.5\n    User shawn\n    IdentityFile /opt/data/.ssh/id_ed25519_hermes\n    IdentitiesOnly yes\n    StrictHostKeyChecking accept-new\n    UserKnownHostsFile /opt/data/.ssh/known_hosts\n' > /etc/ssh/ssh_config.d/hermes.conf

